# ================= 服务 =================
PORT=3002

# ================= MySQL =================
# 建议用 127.0.0.1 而非 localhost（部分环境下 hosts 缺失 localhost 条目会导致 ENOTFOUND）
DB_HOST=127.0.0.1
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_CHARSET=UTF8_GENERAL_CI

# ================= 微信小程序 =================
WX_APPID=your_mini_program_appid
WX_SECRET=your_mini_program_secret

# ================= 微信支付 V2 =================
WX_MCH_ID=your_mch_id
WX_API_KEY=your_32bit_apiv2_key
WX_NOTIFY_URL=https://your-domain.com/wxPayCallback
WX_REFUND_NOTIFY_URL=
# WX_PFX_PATH=/absolute/path/to/apiclient_cert.p12
PAY_SPBILL_IP=127.0.0.1

# ================= 企业微信 =================
WORK_CORPID=your_work_weixin_corpid
WORK_CORPSECRET=your_work_weixin_corpsecret
WORK_NOTIFY_USERID=your_userid
WORK_MINIPROGRAM_PAGE=pages/orderList/orderList

# ================= 文件与静态资源 =================
UPLOAD_DIR=uploads
# TOKEN_DIR=src/data
IMAGE_BASE_URL=https://your-domain.com
